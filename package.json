{
  "name": "launchreel",
  "version": "0.0.1",
  "description": "Turn any website into launch videos and screenshots",
  "type": "module",
  "bin": {
    "launchreel": "dist/index.js",
    "lr": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "test": "vitest"
  },
  "keywords": [
    "product-hunt",
    "screenshots",
    "video",
    "demo",
    "launch",
    "puppeteer",
    "rrweb",
    "recording"
  ],
  "license": "MIT",
  "author": "Tim  Chosen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gudlab/launchreel.git"
  },
  "homepage": "https://github.com/gudlab/launchreel#readme",
  "bugs": {
    "url": "https://github.com/gudlab/launchreel/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "commander": "^13.0.0",
    "dotenv": "^16.4.0",
    "ora": "^8.1.0",
    "puppeteer": "^24.0.0",
    "rrweb": "^2.0.0-alpha.18",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
