# LaunchReel — Environment Variables
# Copy this file to .env and fill in the values you need.

# ── LLM Provider (pick one) ──────────────────────────────────
# Used by `launchreel study` to generate recording configs via AI.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Ollama (local, no key needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=                          # e.g. llama3.1, deepseek-r1, mistral (default: llama3.1)
